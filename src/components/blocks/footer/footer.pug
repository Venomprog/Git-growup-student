mixin footer
  footer.footer 
    .container
      .footer__wrapper
        a.footer__logo.logo(href="#" aria-label="Home page" title="To home page") 
          img(src="/src/assets/img/footer-logo.svg", alt="")
        ul.footer__nav.footer-nav
          li.footer-nav__item
            a.link-element(href="#") Про нас
            a.link-element(href="#") Цены    
          li.footer-nav__item
            a.link-element(href="#") Блог 
            a.link-element(href="#") Контакты
          li.footer-nav__item
            a.link-element(href="#") Вход 
            a.link-element(href="#") Регистрация 
        .footer__networks.footer-networks
          a.link-element(href="mailto:infosmartsign@smarttender.biz") infosmartsign@smarttender.biz
          a.link-element(href="#") Facebook
        ul.footer__contacts.footer-contacts
          li.footer-contacts__item 
            span.footer-contacts__address Центральная улица, 14 А Москва, 02072
          li.footer-contacts__item
            a.link-element(href="tel:0800750643") 0 800 750643
          li.footer-contacts__item
            a.link-element(href="tel:+380443345643") +380 44 334 56 43     
          li.footer-contacts__item 
            a.link-element(href="tel:+380443388643") +380 44 338 86 43   
      .copyright-block
        .copyright 
          a(href="#") © 2020 Signy
        .copyright-block__wrapper
          a.link-element(href="#") Договор
          a.link-element(href="#") Безопасность сервиса