mixin footer
  footer.footer 
    .container
      .footer__wrapper
        a.footer__logo.logo(href="#" aria-label="Home page" title="To home page") 
          img(src="/src/assets/img/footer-logo.svg", alt="")
        ul.footer__nav.footer-nav
          li.footer-nav__item
            a.footer-nav__link(href="#") Про нас
            a.footer-nav__link(href="#") Цены    
          li.footer-nav__item
            a.footer-nav__link(href="#") Блог 
            a.footer-nav__link(href="#") Контакты
          li.footer-nav__item
            a.footer-nav__link(href="#") Вход 
            a.footer-nav__link(href="#") Регистрация 
        .footer__networks.footer-networks
          a.footer-networks__item(href="#") infosmartsign@smarttender.biz
          a.footer-networks__item(href="#") Facebook
        ul.footer__contacts.footer-contacts
          li.footer-contacts__item 
            span.footer-contacts__address Центральная улица, 14 А Москва, 02072
          li.footer-contacts__item
            a.footer-contacts__fone(href="#") 0 800 750643
          li.footer-contacts__item
            a.footer-contacts__fone(href="#") +380 44 334 56 43     
          li.footer-contacts__item 
            a.footer-contacts__fone(href="#") +380 44 338 86 43   
      .copyright-block
        .copyright 
          a(href="#") © 2020 Signy
        .copyright-block__wrapper
          a.copyright-block__link(href="#") Договор
          a.copyright-block__link(href="#") Безопасность сервиса