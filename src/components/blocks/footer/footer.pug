mixin footer
  footer.footer 
    .container
      .footer__wrapper
        a.footer__logo.logo(href="#" aria-label="Home page" title="To home page") 
          img(src="/src/assets/img/footer-logo.svg", alt="")
        ul.footer__nav.footer-nav
          li.footer-nav__item
            a(href="#").footer-nav__link Про нас
            a(href="#").footer-nav__link Цены    
          li.footer-nav__item
            a(href="#").footer-nav__link Блог 
            a(href="#").footer-nav__link Контакты
          li.footer-nav__item
            a(href="#").footer-nav__link Вход 
            a(href="#").footer-nav__link Регистрация 
        .footer__networks.footer-networks
          a(href="#").footer-networks__item infosmartsign@smarttender.biz
          a(href="#").footer-networks__item Facebook
        ul.footer__contacts.footer-contacts
          li.footer-contacts__item 
            span.footer-contacts__text Центральная улица, 14 А Москва, 02072
          li.footer-contacts__item
            span.footer-contacts__text 0 800 750643
          li.footer-contacts__item
            span.footer-contacts__text +380 44 334 56 43     
          li.footer-contacts__item 
            span.footer-contacts__text +380 44 338 86 43   
      .copyright-block
        .copyright 
          a(href="#") © 2020 Signy
        .copyright-block__wrapper
          a(href="#").copyright-block__link Договор
          a(href="#").copyright-block__link Безопасность сервиса