mixin blog 
  section.blog
    .container
      h2.blog__title 
      ul.blog__wrapper
        li.blog__item 
          article.blog-card 
            .blog-card__img
              img(src="src/assets/img/blog-img-1.jpeg" alt="")
            .blog-card__body
              .blog-card__time
                time(datetime="2024-05-28") 28.05.2020
              a.link-element(href="#") 
                h3.blog-card__title Заголовок короткий в две строки
        li.blog__item 
          article.blog-card 
            .blog-card__img
              img(src="src/assets/img/blog-img-2.jpeg" alt="")
            .blog-card__body
              .blog-card__time
                time.blog-card__time(datetime="2024-05-28") 28.05.2020
              a.link-element(href="#")
                h3.blog-card__title Заголовок короткий в две строки
        li.blog__item 
          article.blog-card 
            .blog-card__img
              img(src="src/assets/img/blog-img-1.jpeg" alt="")
            .blog-card__body
              .blog-card__time
                time.blog-card__time(datetime="2024-05-28") 28.05.2024
              a.link-element(href="#")
                h3.blog-card__title Заголовок короткий в две строки

          
