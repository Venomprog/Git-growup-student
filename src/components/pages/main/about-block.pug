mixin about-block 
  section.about 
    .container.about__container 
      .about__wrapper
        .about__text-block
          h2.about__title Комфорт в работе 
          ul.about__list
            li.about__item
              p Создавай документы по твоим личным привычным шаблонам. Это индивидуально!
            li.about__item
              p Настраивай порядок подписание документа, если вас несколько человек. Это ответственно!
            li.about__item
              p Загружай XML файл с собственным шаблоном готового документа. Это удобно!
            li.about__item
              p Работай в супер простом и понятном интерфейсе без сложностей. Это приятно!
          button.button.about__button.button--border(type="button")
            span.button__body УЗНАТЬ БОЛЬШЕ
        .about__img 
          img(src="/src/assets/img/about1.jpeg" alt="")
      .about__wrapper
        .about__img 
          img(src="/src/assets/img/about2.jpeg" alt="")
        .about__text-block
          h2.about__title Наш продукт это: 
          ul.about__list
            li.about__item
              p Web версия без установки программного обеспечения
            li.about__item
              p Возможность бесплатно и безлимитно обрабатывать входящие документы
            li.about__item
              p Простота интеграции с 1С и другими сервисами
            li.about__item
              p Поддержка входа через Mobile ID
          button.button.about__button(type="button")
            span.button__body РЕГИСТРАЦИЯ