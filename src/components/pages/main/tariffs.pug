mixin tariffs
  section.tariffs 
    .container
      ul.tariffs__list
        li.tariffs__item.tariff
          .tariff__wrapper
            h3.tariff__title Demo
            span.tariff__subtitle 30 документoв
            .tariff__price-block 
              span.tariff__price.tariff__price--bold 0
              span.tariff__price руб/месяц
            button.button.tariff__button(type="button")
              span.button__body Зарегистрироваться
        li.tariffs__item.tariff
          .tariff__wrapper
            h3.tariff__title Business
            span.tariff__subtitle 1 000 документoв
            .tariff__price-block 
              span.tariff__price.tariff__price--bold 1 000
              span.tariff__price руб/год
            button.button.tariff__button(type="button")
              span.button__body Закакзать
        li.tariffs__item.tariff
          .tariff__wrapper
            h3.tariff__title Pro
            span.tariff__subtitle 10 000 документoв
            .tariff__price-block 
              span.tariff__price.tariff__price--bold 9000
              span.tariff__price руб/год
            button.button.tariff__button(type="button")
              span.button__body Закакзать
        li.tariffs__item.tariff
          .tariff__wrapper
            h3.tariff__title Individual
            span.tariff__subtitle.tariff__subtitle--margin-b неограниченное количество проектов
            button.button.tariff__button(type="button")
              span.button__body Связаться с нами    
      