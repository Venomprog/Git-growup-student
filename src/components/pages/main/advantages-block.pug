mixin advantages-block 
  section.advantages
    .advantages__container
    .advantages__wrapper
      .advantage-item
        +speedometer-svg
        .advantage-item__text-block
          h3.advantage-item__title Моментально
          p.advantage-item__text Никаких задержек. 1 секунда на подписание
      .advantage-item
        +positive-vote-svg
        .advantage-item__text-block
          h3.advantage-item__title Глобально
          p.advantage-item__text Сервис доступен 24\7 со всех устройств
      .advantage-item
        +piggy-bank-svg
        .advantage-item__text-block
          h3.advantage-item__title Экономно
          p.advantage-item__text В 30 раз дешевле чем почта и курьеры
           
        

