mixin mobile-menu-min()
  .visible-mobile-320.mobile-menu.mobile-menu-320
    .mobile-menu__head
      a.mobile-menu__logo.logo(href="#" aria-label="Home page")
        img(src="/images/logo.svg" alt="" title="To home page")
      .mobile-menu__line
    .mobile-menu__wrapper
      .drop-down.fone-select.mobile-menu__item
        button.drop-down__button(type="button")
          span.drop-down__title 0 800 750 643
          .drop-down__svg
            +drop-down-arrow
        ul.drop-down__container
          li.drop-down__item
            a.link-element.drop-down__link(href="tel:0800750643") 0 800 750643
          li.drop-down__item
            a.link-element.drop-down__link(href="tel:+380443345643") +380 44 334 56 43
          li.drop-down__item
            a.link-element.drop-down__link(href="tel:+380443388643") +380 44 338 86 43
      ul.mobile-menu__list
        li.mobile-menu__item.drop-down
          button.drop-down__button(type="button")
            span.drop-down__title ПРО НАС
            .drop-down__svg
              +drop-down-arrow
          ul.drop-down__container
            li.drop-down__item
              a.link-element.drop-down__link(href="#") БЛОГ
            li.drop-down__item
              a.link-element.drop-down__link(href="#") ВИДЕО
            li.drop-down__item
              a.link-element.drop-down__link(href="#") ВОПРОСЫ
        li.mobile-menu__item
          a.link-element.header__menu-link(href="#") ЦЕНЫ
        li.mobile-menu__item
          a.link-element.header__menu-link(href="#") КОНТАКТЫ
      .mobile-menu__buttons.mobile-menu__item
        +button("Вход")(class="button--border")
        +button("регистрация")
      .mobile-menu__line
      ul.mobile-menu__lang
        li.mobile-menu__item
          a.link-element(href="#") РУС
        li.mobile-menu__item
          a.link-element(href="#") УКР
